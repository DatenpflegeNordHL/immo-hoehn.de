---
const { compact = false } = Astro.props;
---
<section class="contact-section" aria-labelledby="contact-heading">
  <div class="contact-intro">
    <p class="eyebrow">Kontakt</p>
    <h2 id="contact-heading">Sprechen wir über<br />Ihre Immobilie.</h2>
    <p>Ob Verkauf, Wertermittlung, Objektanfrage oder eine erste Frage: Sie erreichen Höhn Immobilien persönlich per Telefon, E-Mail oder über das Formular.</p>
    <div class="contact-meta">
      <a href="tel:+491711230162">0171 1230162</a>
      <a href="mailto:info@immo-hoehn.de">info@immo-hoehn.de</a>
      <span>Trakehnerstraße 11 · 23942 Dassow OT Pötenitz</span>
    </div>
  </div>

  <form
    id="kontaktformular"
    class="contact-form"
    action="/api/contact.php"
    method="post"
    accept-charset="UTF-8"
  >
    <div class="hp-field" aria-hidden="true">
      <label>
        <span>Website</span>
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="form-row">
      <label>
        <span>Name *</span>
        <input type="text" name="name" autocomplete="name" minlength="2" maxlength="120" required />
      </label>
      <label>
        <span>E-Mail *</span>
        <input type="email" name="email" autocomplete="email" maxlength="254" required />
      </label>
    </div>

    <div class="form-row">
      <label>
        <span>Telefon</span>
        <input type="tel" name="telefon" autocomplete="tel" maxlength="60" />
      </label>
      <label>
        <span>Anliegen *</span>
        <select name="anliegen" required>
          <option value="" selected disabled>Bitte auswählen</option>
          <option value="immobilie-verkaufen">Immobilie verkaufen</option>
          <option value="wertermittlung">Wertermittlung</option>
          <option value="objektanfrage">Objektanfrage</option>
          <option value="allgemeine-anfrage">Allgemeine Anfrage</option>
        </select>
      </label>
    </div>

    {!compact && (
      <div class="form-row">
        <label>
          <span>Objektart</span>
          <select name="objektart">
            <option value="">Nicht angegeben</option>
            <option value="haus">Haus</option>
            <option value="wohnung">Wohnung</option>
            <option value="grundstueck">Grundstück</option>
            <option value="gewerbe">Gewerbe</option>
          </select>
        </label>
        <label>
          <span>Ort / PLZ</span>
          <input type="text" name="ort" autocomplete="off" maxlength="120" />
        </label>
      </div>
    )}

    <label class="form-message">
      <span>Nachricht *</span>
      <textarea name="nachricht" rows="5" minlength="10" maxlength="5000" required></textarea>
    </label>

    <label class="consent-row">
      <input type="checkbox" name="datenschutz" value="1" required />
      <span>Ich habe die Hinweise zur Verarbeitung meiner Angaben in der <a href="/datenschutz/">Datenschutzerklärung</a> zur Kenntnis genommen.</span>
    </label>

    <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>

    <div class="form-actions">
      <button type="submit">Anfrage senden <span aria-hidden="true">→</span></button>
      <small>Ihre Angaben werden ausschließlich zur Bearbeitung Ihrer Anfrage verwendet.</small>
    </div>
  </form>
</section>

<script is:inline>
  (() => {
    const status = new URLSearchParams(window.location.search).get('kontakt');
    const output = document.querySelector('[data-form-status]');
    if (!output || !status) return;

    const messages = {
      erfolg: 'Vielen Dank. Ihre Anfrage wurde versendet.',
      ungueltig: 'Bitte prüfen Sie Ihre Eingaben und senden Sie das Formular erneut.',
      versandfehler: 'Die Anfrage konnte gerade nicht versendet werden. Bitte nutzen Sie Telefon oder E-Mail.'
    };

    if (messages[status]) {
      output.textContent = messages[status];
      output.hidden = false;
      output.dataset.status = status === 'erfolg' ? 'success' : 'error';
    }
  })();
</script>

<style>
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .consent-row a {
    text-underline-offset: 3px;
  }

  .form-status {
    margin: 16px 0 0;
    padding: 12px 14px;
    border: 1px solid rgba(23, 58, 74, .18);
    font-size: 12px;
    line-height: 1.55;
  }

  .form-status[data-status='success'] {
    background: rgba(229, 238, 230, .9);
    color: #294b36;
  }

  .form-status[data-status='error'] {
    background: rgba(246, 238, 226, .95);
    color: #67452f;
  }
</style>
