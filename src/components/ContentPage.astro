---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from './ContactPanel.astro';
import { applyLaunchPageOverrides } from '../data/launch-page-overrides.js';

const sourcePage = Astro.props.page;
const page = applyLaunchPageOverrides(sourcePage);
const crumbs = page.slug.split('/');
const site = Astro.site ?? new URL('https://immo-hoehn.de');
const isProduction = import.meta.env.PUBLIC_SITE_NOINDEX === 'false';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Höhn Immobilien',
      item: new URL('/', site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: page.h1,
    },
  ],
};
const heroVariants = {
  '/assets/hero-coast.webp': {
    src: '/assets/hero-coast-960.webp',
    srcset: '/assets/hero-coast-480.webp 480w, /assets/hero-coast-960.webp 960w, /assets/hero-coast-1440.webp 1440w',
    sizes: '(max-width: 900px) 100vw, 50vw',
  },
  '/assets/region-map.webp': {
    src: '/assets/region-map-960.webp',
    srcset: '/assets/region-map-480.webp 480w, /assets/region-map-960.webp 960w',
    sizes: '(max-width: 900px) 100vw, 50vw',
  },
};
const heroMedia = page.heroImage
  ? (heroVariants[page.heroImage] || { src: page.heroImage, srcset: undefined, sizes: undefined })
  : null;
---
<BaseLayout title={page.title} description={page.description} forceNoindex={page.forceNoindex}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <main class="page-main">
    <section class:list={['page-hero', !page.heroImage && 'page-hero--text']}>
      <div class="page-hero-copy">
        <div class="breadcrumbs"><a href="/">Start</a> · {crumbs.map((part) => part.replaceAll('-', ' ')).join(' · ')}</div>
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.intro}</p>
        {(page.primaryCta || page.secondaryCta) && <div class="button-row">
          {page.primaryCta && <a class="button-primary" href={page.primaryCta[0]}>{page.primaryCta[1]} <span aria-hidden="true">→</span></a>}
          {page.secondaryCta && <a class="button-secondary" href={page.secondaryCta[0]}>{page.secondaryCta[1]}</a>}
        </div>}
      </div>
      {heroMedia && <figure class="page-hero-media"><img src={heroMedia.src} srcset={heroMedia.srcset} sizes={heroMedia.sizes} alt="" loading="eager" fetchpriority="high" decoding="async" /></figure>}
    </section>

    {page.kind === 'contact' ? <ContactPanel /> : (
      <div class="content-wrap">
        {page.kind === 'legal' && !isProduction && <div class="legal-warning">Diese Seite ist auf dem Arbeitsbranch noch nicht für den Produktivbetrieb freigegeben. Rechtliche Inhalte werden vor Deployment separat geprüft.</div>}
        <div class="content-grid">
          <article class="content-prose">
            {(page.blocks || []).map((block) => <section class="content-block">
              <h2>{block.heading}</h2>
              {(block.paragraphs || []).map((paragraph) => <p>{paragraph.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>)}
              {block.bullets && <ul>{block.bullets.map((item) => <li>{item}</li>)}</ul>}
              {block.links && <div class="region-links">{block.links.map(([href,label]) => <a href={href}>{label}</a>)}</div>}
            </section>)}

            {page.faqs && <section class="content-block">
              <p class="eyebrow">Fragen & Antworten</p>
              <h2>Häufige Fragen</h2>
              <div class="faq-list">{page.faqs.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
            </section>}
          </article>

          <aside class="side-card">
            <p class="eyebrow">Höhn Immobilien</p>
            <h2>Persönlich erreichbar</h2>
            <p>Christine Bringmann<br />Trakehnerstraße 11<br />23942 Dassow OT Pötenitz</p>
            <a href="tel:+491711230162">0171 1230162</a>
            <a href="mailto:info@immo-hoehn.de">info@immo-hoehn.de</a>
            <div class="button-row"><a class="button-primary" href="/kontakt/">Kontakt aufnehmen</a></div>
          </aside>
        </div>
      </div>
    )}
  </main>
</BaseLayout>
