---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { properties } from '../data/properties.js';
import { PUBLISH_PROPERTY_LISTINGS } from '../data/launch-config.js';

const publishedProperties = PUBLISH_PROPERTY_LISTINGS ? properties : [];
---
<BaseLayout
  title="Höhn Immobilien | Immobilien an der Ostseeküste"
  description="Höhn Immobilien begleitet Eigentümer und Käufer an der Ostseeküste bei Verkauf, Wertermittlung und Vermittlung – persönlich und erfahren seit 1986."
  hideFooter={true}
>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <figure class="hero-photo" aria-hidden="true">
        <img
          src="/assets/hero-coast-960.webp"
          srcset="/assets/hero-coast-480.webp 480w, /assets/hero-coast-960.webp 960w, /assets/hero-coast-1440.webp 1440w"
          sizes="(max-width: 900px) 100vw, (max-width: 1440px) calc(100vw - 140px), 1300px"
          width="960"
          height="546"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <div class="hero-photo-fade" aria-hidden="true"></div>

      <div class="hero-copy">
        <p class="eyebrow">Höhn Immobilien · Ostseeküste</p>
        <h1 id="hero-title">Immobilien an<br />der Ostseeküste.</h1>
        <p class="hero-intro">Persönliche Begleitung bei Verkauf, Wertermittlung und Vermittlung – seit 1986.</p>
        <div class="place-row"><span class="short-rule"></span><span>Dassow · Pötenitz · Rosenhagen · Travemünde · Priwall</span></div>
        <div class="hero-actions">
          <a class="btn-primary" href="/immobilie-verkaufen/">Immobilie verkaufen <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/immobilien/">Immobilien entdecken</a>
        </div>
        <div class="hero-meta">
          <p>Standort in<br />Dassow OT Pötenitz.</p>
        </div>
      </div>

      <aside class="hero-note" aria-label="Unternehmensnotiz">
        <p class="hero-note-hand">Persönlich<br />seit 1986.</p>
        <span class="hero-note-rule" aria-hidden="true"></span>
        <p class="coordinates">HÖHN IMMOBILIEN<br />DASSOW OT PÖTENITZ<br />OSTSEEKÜSTE</p>
      </aside>
    </section>

    <section id="regionen" class="region-section" aria-labelledby="region-heading">
      <div class="map-panel">
        <img
          class="map-art"
          src="/assets/region-map-480.webp"
          srcset="/assets/region-map-480.webp 480w, /assets/region-map-960.webp 960w"
          sizes="(max-width: 580px) 100vw, (max-width: 900px) 50vw, 480px"
          width="480"
          height="160"
          alt="Illustrative Küstenkarte im Raum Dassow"
          loading="lazy"
          decoding="async"
        />
        <span class="map-caption">Unsere Region</span>
        <span class="map-compass" aria-hidden="true"><img src="/assets/compass-128.webp" width="128" height="128" alt="" loading="lazy" decoding="async" /></span>
        <p class="map-coordinates">DASSOW<br />PÖTENITZ<br />OSTSEEKÜSTE</p>
      </div>

      <div class="region-list" aria-label="Regionen">
        <article><p class="region-title"><a href="/regionen/dassow/">DASSOW</a></p><p>Standortregion von Höhn Immobilien</p></article>
        <article><p class="region-title"><a href="/regionen/poetenitz/">PÖTENITZ</a></p><p>Unternehmensstandort an der Ostseeküste</p></article>
        <article><p class="region-title"><a href="/regionen/rosenhagen/">ROSENHAGEN</a></p><p>Grundstücke und Küstenlage</p></article>
        <article><p class="region-title"><a href="/regionen/travemuende/">TRAVEMÜNDE</a></p><p>Verkauf, Bewertung und Vermittlung</p></article>
        <article><p class="region-title"><a href="/regionen/priwall/">PRIWALL</a></p><p>Immobilien zwischen Trave und Ostsee</p></article>
      </div>

      <div class="region-story">
        <p class="eyebrow">Unsere Region</p>
        <h2 id="region-heading">Eine Küste.<br />Konkrete<br />Lagen.</h2>
        <p class="region-copy">Von Dassow und Pötenitz bis Travemünde und Priwall: Höhn Immobilien begleitet Eigentümer und Interessenten in ausgewählten Lagen entlang der Ostseeküste persönlich und objektbezogen.</p>
      </div>

      <div class="grass-panel" aria-hidden="true">
        <img src="/assets/region-dune-grass-320.webp" width="320" height="569" alt="" loading="lazy" decoding="async" />
        <p class="micro-note">REGION<br />OBJEKT<br />VERTRAUEN</p>
      </div>
    </section>

    <section class="property-section" aria-labelledby="property-heading">
      <div class="property-section-head">
        <div><p class="eyebrow">Immobilienangebote</p><h2 id="property-heading">Aktuell heißt:<br />wirklich bestätigt.</h2></div>
        <p>Objekte erscheinen hier erst, wenn Verfügbarkeit und Vermarktungsstatus aktuell bestätigt sind.</p>
      </div>
      {publishedProperties.length > 0 ? (
        <div class="property-cards">
          {publishedProperties.map((property) => <article class="property-card">
            <p class="kicker">{property.type} · {property.location}</p>
            <h3>{property.title}</h3>
            <p class="price">{property.price}</p>
            <p class="facts">{property.summary}</p>
            <a href={`/immobilien/${property.slug}/`}>Objekt ansehen →</a>
          </article>)}
        </div>
      ) : (
        <div class="content-prose">
          <h3>Derzeit keine Angebote als aktuell bestätigt</h3>
          <p>Aktuell ist kein Objektbestand zur Veröffentlichung bestätigt. Für Kauf- oder Grundstücksanfragen erreichen Sie Höhn Immobilien direkt.</p>
          <div class="button-row"><a class="button-primary" href="/kontakt/">Aktuelle Angebote anfragen</a><a class="button-secondary" href="/immobilien/">Zur Immobilienübersicht</a></div>
        </div>
      )}
    </section>

    <section id="verkaufen" class="after-reference sell-section">
      <div>
        <p class="eyebrow">Immobilie verkaufen</p>
        <h2>Ein guter Verkauf beginnt<br />vor dem Inserat.</h2>
        <p class="sell-copy">Höhn Immobilien begleitet Eigentümer von Beratung und Wertermittlung über Exposé, Vermarktung und Besichtigungen bis zu Verhandlung, Notartermin und Übergabe.</p>
        <div class="button-row"><a class="button-primary" href="/immobilie-verkaufen/">Verkauf besprechen</a><a class="button-secondary" href="/immobilienbewertung/">Wertermittlung</a></div>
      </div>
    </section>

    <ContactPanel compact={true} />
  </main>

  <footer id="ueber-uns" class="heritage-footer" aria-labelledby="heritage-title">
    <div class="heritage">
      <div class="heritage-year"><span>Seit</span><strong id="heritage-title">1986</strong><i></i></div>
      <div class="heritage-copy"><p>INHABERGEFÜHRT<br />PERSÖNLICH<br />AN DER OSTSEEKÜSTE.</p></div>
      <figure class="heritage-sketch"><img src="/assets/heritage-house-600.webp" width="600" height="300" alt="Illustration eines norddeutschen Hauses" loading="lazy" decoding="async" /></figure>
      <p class="heritage-note">Wert<br />begleiten.</p>
      <div class="heritage-values">
        <div><strong>INHABERGEFÜHRT</strong><span>Christine Bringmann</span></div>
        <div><strong>REGIONAL</strong><span>Pötenitz / Dassow</span></div>
        <div><strong>VERMITTLUNG</strong><span>Wohn- & Gewerbe</span></div>
        <div><strong>ERFAHREN</strong><span>seit 1986</span></div>
      </div>
    </div>

    <div class="heritage-footer-meta">
      <div class="heritage-footer-identity">
        <strong>Höhn Immobilien</strong>
        <span>Christine Bringmann · Trakehnerstraße 11 · 23942 Dassow OT Pötenitz</span>
      </div>
      <div class="heritage-footer-contact">
        <a href="tel:+491711230162">0171 1230162</a>
        <a href="mailto:info@immo-hoehn.de">info@immo-hoehn.de</a>
      </div>
      <nav class="heritage-footer-nav" aria-label="Fußnavigation">
        <a href="/kontakt/">Kontakt</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </nav>
      <div class="heritage-footer-copy">© 2026 Höhn Immobilien</div>
    </div>
  </footer>

  <style>
    .heritage-footer {
      max-width: 1440px;
      margin: 0 auto;
      background: rgba(241, 240, 236, .94);
      border-top: 1px solid rgba(23, 58, 74, .04);
    }

    .heritage-footer .heritage {
      border-top: 0;
    }

    .heritage-footer-meta {
      display: grid;
      grid-template-columns: minmax(280px, 1.6fr) minmax(180px, .8fr) auto auto;
      align-items: center;
      gap: 24px;
      padding: 18px 46px 22px;
      border-top: 1px solid rgba(23, 58, 74, .10);
      color: #526a75;
    }

    .heritage-footer-identity {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .heritage-footer-identity strong {
      font: 400 20px/1 var(--serif);
      color: var(--ink);
    }

    .heritage-footer-identity span,
    .heritage-footer-contact a,
    .heritage-footer-nav a,
    .heritage-footer-copy {
      font-size: 9px;
      line-height: 1.5;
    }

    .heritage-footer-contact {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .heritage-footer-contact a,
    .heritage-footer-nav a {
      min-height: 28px;
      display: inline-flex;
      align-items: center;
      text-underline-offset: 3px;
    }

    .heritage-footer-nav {
      display: flex;
      gap: 16px;
      white-space: nowrap;
    }

    .heritage-footer-copy {
      white-space: nowrap;
      color: #788a92;
    }

    @media (max-width: 900px) {
      .heritage-footer-meta {
        grid-template-columns: 1fr 1fr;
        gap: 14px 28px;
        padding: 20px 22px 24px;
      }

      .heritage-footer-nav {
        justify-self: start;
      }

      .heritage-footer-copy {
        justify-self: end;
      }
    }

    @media (max-width: 580px) {
      .heritage-footer-meta {
        grid-template-columns: 1fr;
        gap: 10px;
        padding: 20px 22px 24px;
      }

      .heritage-footer-identity {
        gap: 6px;
      }

      .heritage-footer-identity strong {
        font-size: 22px;
      }

      .heritage-footer-identity span,
      .heritage-footer-contact a,
      .heritage-footer-nav a,
      .heritage-footer-copy {
        font-size: 11px;
      }

      .heritage-footer-contact {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 4px 18px;
      }

      .heritage-footer-contact a,
      .heritage-footer-nav a {
        min-height: 36px;
      }

      .heritage-footer-nav {
        gap: 18px;
        flex-wrap: wrap;
      }

      .heritage-footer-copy {
        justify-self: start;
        padding-top: 2px;
        font-size: 10px;
      }
    }
  </style>
</BaseLayout>
