---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { properties } from '../../data/properties.js';
import { PUBLISH_PROPERTY_LISTINGS } from '../../data/launch-config.js';

const site = Astro.site ?? new URL('https://immo-hoehn.de');
const publishedProperties = PUBLISH_PROPERTY_LISTINGS ? properties : [];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Höhn Immobilien',
      item: new URL('/', site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Immobilien',
    },
  ],
};
---
<BaseLayout
  title="Immobilien an der Ostseeküste | Höhn Immobilien"
  description="Immobilien und Grundstücke an der Ostseeküste mit Höhn Immobilien. Aktuelle Angebote werden nach bestätigter Verfügbarkeit veröffentlicht; Anfragen sind direkt möglich."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <main class="page-main">
    <section class="page-hero">
      <div class="page-hero-copy">
        <div class="breadcrumbs"><a href="/">Start</a> · Immobilien</div>
        <p class="eyebrow">Immobilienangebote</p>
        <h1>Immobilien an der Ostseeküste</h1>
        <p class="lead">Aktuelle Angebote veröffentlichen wir hier, sobald Verfügbarkeit und aktuelles Vermarktungsmandat bestätigt sind. So sehen Sie keine veralteten oder nur historisch dokumentierten Objekte als vermeintlich aktuellen Bestand.</p>
      </div>
      <figure class="page-hero-media">
        <img
          src="/assets/hero-coast-960.webp"
          srcset="/assets/hero-coast-480.webp 480w, /assets/hero-coast-960.webp 960w, /assets/hero-coast-1440.webp 1440w"
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Küstenlandschaft an der Ostsee"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </section>

    <section class="property-section">
      <div class="property-section-head">
        <div><p class="eyebrow">Angebote</p><h2>Immobilien & Grundstücke</h2></div>
        <p>Verfügbarkeit und Vermarktungsstatus werden vor jeder Veröffentlichung geprüft.</p>
      </div>
      {publishedProperties.length > 0 ? (
        <div class="property-cards">
          {publishedProperties.map((property) => <article class="property-card">
            <p class="kicker">{property.type} · {property.location}</p>
            <h3>{property.title}</h3>
            <p class="price">{property.price}</p>
            <p class="facts">{property.summary}</p>
            <a href={`/immobilien/${property.slug}/`}>Details ansehen →</a>
          </article>)}
        </div>
      ) : (
        <div class="content-prose">
          <h3>Derzeit keine Angebote als aktuell bestätigt</h3>
          <p>Die bisher dokumentierten Objektdaten bleiben intern erhalten, werden zum Relaunch aber nicht als aktueller Höhn-Bestand ausgegeben. Für aktuelle Kauf- oder Grundstücksanfragen erreichen Sie Höhn Immobilien direkt.</p>
          <div class="button-row"><a class="button-primary" href="/kontakt/">Aktuelle Angebote anfragen</a></div>
        </div>
      )}
    </section>

    <section class="after-reference">
      <p class="eyebrow">Für Eigentümer</p>
      <h2>Sie möchten selbst eine Immobilie anbieten?</h2>
      <p class="sell-copy">Wenn Sie ein Haus, eine Wohnung oder ein Grundstück verkaufen möchten, sprechen wir mit Ihnen über Wertermittlung, Präsentation und den weiteren Vermarktungsprozess.</p>
      <div class="button-row"><a class="button-primary" href="/immobilie-verkaufen/">Immobilie verkaufen</a><a class="button-secondary" href="/kontakt/">Kontakt aufnehmen</a></div>
    </section>
  </main>
</BaseLayout>
