---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { properties } from '../../data/properties.js';
import { getPropertyMedia } from '../../data/property-media.js';
import { PUBLISH_PROPERTY_LISTINGS } from '../../data/launch-config.js';

export function getStaticPaths() {
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }));
}

const { property } = Astro.props;
const media = getPropertyMedia(property.slug);
const mediaFallback = '/assets/rosenhagen-beach.webp';
const mediaLabel = (kind) => {
  if (kind === 'plan') return 'Kataster / Plan';
  if (kind === 'visualization') return 'Visualisierung';
  if (kind === 'location') return 'Lagebild';
  return 'Projektbild';
};
const title = `${property.title} | Höhn Immobilien`;
const description = `${property.summary} Informationen und persönliche Beratung von Höhn Immobilien.`;
const site = Astro.site ?? new URL('https://immo-hoehn.de');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Höhn Immobilien',
      item: new URL('/', site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Immobilien',
      item: new URL('/immobilien/', site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: property.title,
    },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  image={media.hero.src}
  imageAlt={media.hero.alt}
  forceNoindex={!PUBLISH_PROPERTY_LISTINGS}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <main class="page-main">
    <section class="page-hero">
      <div class="page-hero-copy">
        <div class="breadcrumbs"><a href="/">Start</a> · <a href="/immobilien/">Immobilien</a> · {property.location}</div>
        <p class="eyebrow">{property.type} · {property.status}</p>
        <h1>{property.title}</h1>
        <p class="lead">{property.summary}</p>
        <div class="button-row"><a class="button-primary" href="/kontakt/">Verfügbarkeit anfragen</a><a class="button-secondary" href="/immobilien/">Immobilienübersicht</a></div>
      </div>
      <figure class="page-hero-media property-hero-media" style={`background-image:url('${mediaFallback}')`}>
        <img
          src={media.hero.src}
          alt={media.hero.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          onerror="this.style.display='none';"
        />
        <figcaption class="property-media-label">{mediaLabel(media.hero.kind)}</figcaption>
      </figure>
    </section>

    <div class="content-wrap">
      <div class="content-grid">
        <article class="content-prose">
          <section class="content-block">
            <p class="eyebrow">Eckdaten</p>
            <h2>{property.price}</h2>
            <div class="detail-facts">
              {property.facts.map(([label,value]) => <div class="detail-fact"><span>{label}</span><strong>{value}</strong></div>)}
            </div>
            <p class="verified-note">Änderungen, Reservierung und Zwischenverkauf bleiben vorbehalten.</p>
          </section>

          <section class="content-block">
            <h2>Zum Angebot</h2>
            <p>{property.summary}</p>
          </section>

          {media.gallery.length > 0 && (
            <section class="content-block property-gallery-block">
              <p class="eyebrow">Impressionen</p>
              <h2>Bilder zu {property.location}</h2>
              <div class="property-gallery-grid">
                {media.gallery.map((item) => (
                  <figure class="property-gallery-item">
                    <img
                      src={item.src}
                      alt={item.alt}
                      loading="lazy"
                      decoding="async"
                      onerror="this.closest('figure').hidden=true;"
                    />
                    <figcaption>
                      <span>{item.caption}</span>
                      <small>{mediaLabel(item.kind)}</small>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}

          {(property.sections || []).map((section) => (
            <section class="content-block">
              <h2>{section.heading}</h2>
              {(section.paragraphs || []).map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
        </article>
        <aside class="side-card">
          <p class="eyebrow">Ansprechpartner</p>
          <h2>Höhn Immobilien</h2>
          <p>Christine Bringmann<br />Trakehnerstraße 11<br />23942 Dassow OT Pötenitz</p>
          <a href="tel:+493882680911">038826 80911</a>
          <a href="tel:+491711230162">0171 1230162</a>
          <a href="mailto:info@immo-hoehn.de">info@immo-hoehn.de</a>
          <div class="button-row"><a class="button-primary" href="/kontakt/">Status anfragen</a></div>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
