---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { properties } from '../../data/properties.js';
import { PUBLISH_PROPERTY_LISTINGS } from '../../data/launch-config.js';

export function getStaticPaths() {
  return properties.map((property) => ({ params: { slug: property.slug }, props: { property } }));
}

const { property } = Astro.props;
const title = `${property.title} | Höhn Immobilien`;
const description = PUBLISH_PROPERTY_LISTINGS
  ? `${property.summary} Aktuelle Objektdaten von Höhn Immobilien.`
  : `${property.summary} Dokumentierte Angaben aus dem bisherigen Höhn-Bestand; aktuelle Verfügbarkeit ist nicht bestätigt.`;
const site = Astro.site ?? new URL('https://immo-hoehn.de');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Höhn Immobilien',
      item: new URL('/', site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Immobilien',
      item: new URL('/immobilien/', site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: property.title,
    },
  ],
};
const isRosenhagen = property.location === 'Rosenhagen';
const hero = isRosenhagen
  ? { src: '/assets/rosenhagen-beach.webp', srcset: undefined, sizes: undefined }
  : {
      src: '/assets/hero-coast-960.webp',
      srcset: '/assets/hero-coast-480.webp 480w, /assets/hero-coast-960.webp 960w, /assets/hero-coast-1440.webp 1440w',
      sizes: '(max-width: 900px) 100vw, 50vw',
    };
const statusLabel = PUBLISH_PROPERTY_LISTINGS ? property.status : 'Verfügbarkeit nicht aktuell bestätigt';
---
<BaseLayout
  title={title}
  description={description}
  image={isRosenhagen ? '/assets/rosenhagen-beach.webp' : '/assets/hero-coast-1440.webp'}
  imageAlt={`${property.title} – Höhn Immobilien`}
  forceNoindex={!PUBLISH_PROPERTY_LISTINGS}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <main class="page-main">
    <section class="page-hero">
      <div class="page-hero-copy">
        <div class="breadcrumbs"><a href="/">Start</a> · <a href="/immobilien/">Immobilien</a> · {property.location}</div>
        <p class="eyebrow">{property.type} · {statusLabel}</p>
        <h1>{property.title}</h1>
        <p class="lead">{property.summary}</p>
        <div class="button-row"><a class="button-primary" href="/kontakt/">Verfügbarkeit anfragen</a><a class="button-secondary" href="/immobilien/">Immobilienübersicht</a></div>
      </div>
      <figure class="page-hero-media">
        <img
          src={hero.src}
          srcset={hero.srcset}
          sizes={hero.sizes}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </section>

    <div class="content-wrap">
      <div class="content-grid">
        <article class="content-prose">
          {!PUBLISH_PROPERTY_LISTINGS && (
            <section class="content-block object-source-note">
              <p class="eyebrow">Hinweis zum Datenstand</p>
              <h2>Dieses Objekt wird derzeit nicht als aktuelles Höhn-Angebot veröffentlicht</h2>
              <p>Die folgenden Angaben stammen aus dem dokumentierten bisherigen Höhn-Bestand. Ein aktuelles Vermarktungsmandat und die heutige Verfügbarkeit konnten zum Relaunch nicht frisch bestätigt werden. Bitte fragen Sie den aktuellen Status direkt bei Höhn Immobilien an.</p>
            </section>
          )}

          <section class="content-block">
            <p class="eyebrow">Eckdaten</p>
            <h2>{property.price}</h2>
            <div class="detail-facts">
              {property.facts.map(([label,value]) => <div class="detail-fact"><span>{label}</span><strong>{value}</strong></div>)}
            </div>
            <p class="verified-note">
              {PUBLISH_PROPERTY_LISTINGS
                ? `Datenstand: ${property.verifiedAt}. Änderungen, Reservierung und Zwischenverkauf bleiben vorbehalten.`
                : `Dokumentierter Datenstand: ${property.verifiedAt}. Die Angaben sind nicht als Bestätigung der heutigen Verfügbarkeit zu verstehen.`}
            </p>
          </section>

          <section class="content-block">
            <h2>Zum Objekt</h2>
            <p>{property.summary}</p>
          </section>

          {(property.sections || []).map((section) => (
            <section class="content-block">
              <h2>{section.heading}</h2>
              {(section.paragraphs || []).map((paragraph) => <p>{PUBLISH_PROPERTY_LISTINGS ? paragraph : paragraph.replaceAll('aktuelle Höhn-Objektseite', 'bisherige Höhn-Objektseite').replaceAll('aktuelle Höhn-Seite', 'bisherige Höhn-Seite').replaceAll('aktuellen Höhn-Angebot', 'bisherigen Höhn-Angebot')}</p>)}
            </section>
          ))}

          {property.commission && (
            <section class="content-block object-source-note">
              <p class="eyebrow">Datenquelle</p>
              <h2>{PUBLISH_PROPERTY_LISTINGS ? 'Aktueller Höhn-Bestand' : 'Angaben aus dem bisherigen Höhn-Bestand'}</h2>
              <p>{PUBLISH_PROPERTY_LISTINGS
                ? 'Die dargestellten Objektangaben wurden aus der öffentlich geführten Höhn-Objektseite übernommen und für den Relaunch auf die dort belegten Angaben beschränkt.'
                : 'Die dargestellten Objektangaben wurden aus der öffentlich geführten Höhn-Objektseite übernommen und auf belegbare Informationen beschränkt. Die Quelle kann inzwischen veraltet oder technisch nicht erreichbar sein.'}</p>
              <p><a href={property.sourceUrl} rel="nofollow">Höhn-Bestandsseite zum Objekt ansehen →</a></p>
            </section>
          )}
        </article>
        <aside class="side-card">
          <p class="eyebrow">Ansprechpartner</p>
          <h2>Höhn Immobilien</h2>
          <p>Christine Bringmann<br />Trakehnerstraße 11<br />23942 Dassow OT Pötenitz</p>
          <a href="tel:+493882680911">038826 80911</a>
          <a href="tel:+491711230162">0171 1230162</a>
          <a href="mailto:info@immo-hoehn.de">info@immo-hoehn.de</a>
          <div class="button-row"><a class="button-primary" href="/kontakt/">Status anfragen</a></div>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
